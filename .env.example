# =====================================================
# AI E-Commerce Lead Generator - Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# =====================================================

# =====================================================
# Supabase Configuration
# =====================================================
# Get these values from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

# Supabase Project URL
# Example: https://abcdefghijklmnop.supabase.co


# Supabase Anon/Public Key
# This key is safe to use in a browser context
# It respects Row Level Security (RLS) policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =====================================================
# Supabase Service Role Key (Backend Only)
# =====================================================
# WARNING: Keep this secret! It bypasses RLS policies.
# Only use this on the server-side (API routes, server components)
# NEVER expose this in client-side code

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================
# Supabase Database Connection (Optional)
# =====================================================
# Direct database connection string for migrations and advanced queries
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

SUPABASE_DB_URL=

# =====================================================
# Next.js Configuration
# =====================================================

# Application URL (used for OAuth callbacks and emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# =====================================================
# Authentication Configuration
# =====================================================

# JWT Secret (for custom auth implementations)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret

# Session cookie name
AUTH_COOKIE_NAME=sb-auth-token

# =====================================================
# Email Configuration - Resend
# =====================================================
# Resend: https://resend.com - ingyenes tier: 3000 email/hó
# 1. Regisztrálj: https://resend.com/signup
# 2. API key: https://resend.com/api-keys
# 3. Saját domain hozzáadása (production): https://resend.com/domains

# Resend API kulcs (kötelező az email értesítésekhez)
RESEND_API_KEY=re_your_api_key_here

# Feladó email cím
# Sandbox módban CSAK "onboarding@resend.dev" működik (Resend ingyenes fiók)
# Production-ban saját domain kell: pl. noreply@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# =====================================================
# OAuth Providers (Optional)
# =====================================================
# Configure these in Supabase dashboard and add keys here

# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# =====================================================
# Feature Flags (Optional)
# =====================================================

# Enable debug logging
DEBUG=false

# Enable maintenance mode
MAINTENANCE_MODE=false

# =====================================================
# Analytics & Monitoring (Future)
# =====================================================

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# PostHog Analytics
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# =====================================================
# AI Services (Future Phases)
# =====================================================

# OpenAI API Key (for AI features)
# OPENAI_API_KEY=your-openai-api-key

# =====================================================
# Storage Configuration (Future)
# =====================================================

# AWS S3 (if using custom storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# =====================================================
# Rate Limiting & Security (Future)
# =====================================================

# Redis URL (for rate limiting and caching)
# REDIS_URL=redis://localhost:6379

# API Rate Limits
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW=60000

# =====================================================
# Development Tools
# =====================================================

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1

# =====================================================
# Local Development URLs (Supabase CLI)
# =====================================================
# These are automatically set when using `supabase start`
# Uncomment if you need to override defaults

# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

 
